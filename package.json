{
  "private": true,
  "name": "hapin",
  "scripts": {
    "start": "dumi dev",
    "build": "dumi build && node scripts/legacy-redirects.mjs && node scripts/check-dist.mjs",
    "prettier": "prettier --write \"**/*.{js,jsx,tsx,ts,less,md,json}\"",
    "prepare": "dumi setup",
    "docs:sync": "node scripts/sync-examples.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "check": "yarn docs:check && yarn typecheck && yarn build"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "typings": "dist/index.d.ts",
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "devDependencies": {
    "dumi": "^2.0.0",
    "lint-staged": "^10.0.7",
    "prettier": "^2.2.1",
    "typescript": "^5.3.3",
    "yorkie": "^2.0.0"
  },
  "dependencies": {},
  "packageManager": "yarn@1.22.22"
}
